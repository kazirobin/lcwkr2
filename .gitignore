# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# npm is the package manager here, so the lock file is what Vercel installs from.
# Without it npm resolves the caret ranges afresh on every deploy, which lets
# pdfjs-dist move out from under the committed worker in public/pdfjs/ and
# break the lesson PDF viewer at runtime rather than at build time.
# yarn.lock is still ignored so a stray yarn install cannot conflict with it.
yarn.lock
# dev logs
dev.*
devserver.*
lcwkr-*.log
# the local `next start` log, which is machine output and not source
run.log



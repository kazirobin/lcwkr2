# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# MongoDB connection string (Atlas SRV or standard URI)
MONGODB_URI=

# NextAuth (currently unused by the app, reserved for real auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Staff gate passcodes. NEXT_PUBLIC_* is exposed to the browser — the current
# /academy/admin gate is client-side only; treat these as throwaway until
# server-enforced auth lands (see docs/architecture.md).
NEXT_PUBLIC_ADMIN_PASSCODE=
ADMIN_PASSCODE=
TEACHER_PASSCODE=

# WhatsApp number shown in the UI (with country code)
NEXT_PUBLIC_ADMIN_WHATSAPP=

# Optional: canonical site URL for metadata / sitemap (defaults to the prod URL)
NEXT_PUBLIC_SITE_URL=
